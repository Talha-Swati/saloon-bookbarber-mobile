# Public Supabase client configuration (never put a service-role key here)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Development builds only. Set to false (or remove it) for real authentication.
EXPO_PUBLIC_DEMO_AUTH_BYPASS=false

# Base URL of the BookBarber web backend, used only for payment initiation
# (POST /api/payments/initiate). Public configuration, not a secret — merchant
# credentials stay on the web server and are never sent to the app. Leave it unset and
# deposit payment simply reports itself as unavailable.
EXPO_PUBLIC_API_URL=http://localhost:3000
